Description: Fix SHAKE128 support for OpenSSL 3.x
 SHAKE128 is an XOF (extendable-output function) and requires
 EVP_DigestFinalXOF instead of EVP_DigestFinal in OpenSSL 3.x.
 This patch adds detection for XOF functions and uses the appropriate
 finalization function.
Author: Paul Gear
Bug-Debian: https://bugs.debian.org/XXXXXX
Forwarded: no
Last-Update: 2025-02-13

--- a/sntp/crypto.c
+++ b/sntp/crypto.c
@@ -101,7 +101,17 @@ compute_mac(
 				macname);
 			goto mac_fail;
 		}
-		if (!EVP_DigestFinal(ctx, digest, &len)) {
+		/* SHAKE128 and SHAKE256 are XOFs and require EVP_DigestFinalXOF */
+		if (key_type == NID_shake128 || key_type == NID_shake256) {
+			/* For XOF functions, we need to specify the output length */
+			if (!EVP_DigestFinalXOF(ctx, digest, dig_sz)) {
+				msyslog(LOG_ERR, "make_mac: MAC %s Digest FinalXOF failed.",
+					macname);
+				len = 0;
+			} else {
+				len = dig_sz;
+			}
+		} else if (!EVP_DigestFinal(ctx, digest, &len)) {
 			msyslog(LOG_ERR, "make_mac: MAC %s Digest Final failed.",
 				macname);
 			len = 0;
