ARG RELEASE=bookworm
FROM debian:${RELEASE}

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    autogen \
    debhelper \
    dh-apparmor \
    libcap2-dev \
    libedit-dev \
    libevent-dev \
    libopts25-dev \
    libssl-dev \
    pkg-config \
    pps-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . /build/

# Build the package (unsigned)
# To sign: add devscripts package and use debsign, or add -k <keyid> to dpkg-buildpackage
RUN dpkg-buildpackage -us -uc

# Output .deb files to /output (mounted by host)
VOLUME /output
